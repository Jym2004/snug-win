<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WPF initializes DPI before WinForms Application.SetHighDpiMode runs; keep PerMonitorV2 in app.manifest -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SnugWin.Core\SnugWin.Core.csproj" />
    <ProjectReference Include="..\SnugWin.Windows\SnugWin.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\Assets\phone-models.json" Link="Assets\phone-models.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
