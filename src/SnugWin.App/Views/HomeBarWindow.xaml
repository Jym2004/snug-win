<Window x:Class="SnugWin.App.Views.HomeBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnugHomeBar"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource HomeBarBg}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True">
    <Grid x:Name="RootGrid"
          Cursor="Hand"
          Background="{DynamicResource HomeBarBg}"
          MouseLeftButtonUp="OnBarClick"
          PreviewMouseWheel="OnBarWheel"
          ToolTip="点按或上滑回到 App 资源库">
        <!-- Optional left camera icon (HomeBarView.showsCamera) -->
        <Grid x:Name="CameraBox"
              Width="56"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              Visibility="Collapsed">
            <Canvas x:Name="CameraGlyph"
                    Width="22" Height="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Rectangle Canvas.Left="1" Canvas.Top="4" Width="20" Height="13" RadiusX="3" RadiusY="3"
                           Stroke="{DynamicResource HomeBarFg}" StrokeThickness="1.8"/>
                <Path Data="M 7,4 L 8.5,1.5 L 13.5,1.5 L 15,4"
                      Stroke="{DynamicResource HomeBarFg}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="7.5" Canvas.Top="7" Width="7" Height="7"
                         Stroke="{DynamicResource HomeBarFg}" StrokeThickness="1.8"/>
            </Canvas>
        </Grid>

        <!-- Center chevron grabber -->
        <Path x:Name="ChevronPath"
              Data="M 0,6 L 14,0 L 28,6"
              Stroke="{DynamicResource HomeBarFg}"
              StrokeThickness="3"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              SnapsToDevicePixels="False"/>
    </Grid>
</Window>
