<Window x:Class="SnugWin.App.Views.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnugCrop"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#000000"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True">
    <Grid x:Name="CropCanvasGrid"
          Background="#000000"
          SizeChanged="OnSizeChanged"
          MouseLeftButtonDown="OnCanvasMouseDown"
          MouseMove="OnCanvasMouseMove"
          MouseLeftButtonUp="OnCanvasMouseUp">
        <!-- Screenshot image fitted in center -->
        <Canvas x:Name="SceneCanvas" ClipToBounds="True">
            <Image x:Name="TargetImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
            <!-- Scrim outside selection -->
            <Path x:Name="ScrimPath" Fill="#8C000000" IsHitTestVisible="False"/>
            <!-- Thin selection border -->
            <Rectangle x:Name="SelectionBorder" Stroke="#CCFFFFFF" IsHitTestVisible="False"/>
            <!-- 4 corner L handles & 4 edge tick handles -->
            <Path x:Name="HandlesPath" Stroke="#FFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" IsHitTestVisible="False"/>
        </Canvas>

        <!-- Top cancel / done bar -->
        <Grid x:Name="TopBarGrid" VerticalAlignment="Top" Height="64">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B3000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Button x:Name="CancelBtn" Content="取消" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Foreground="White" FontSize="18" FontWeight="SemiBold"
                    Padding="20,10" Click="OnCancelClick"/>
            <Button x:Name="DoneBtn" Content="完成" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Foreground="White" FontSize="18" FontWeight="SemiBold"
                    Padding="20,10" Click="OnDoneClick"/>
        </Grid>
    </Grid>
</Window>
