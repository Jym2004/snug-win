<Window x:Class="SnugWin.App.Views.PhoneModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择手机型号与比例"
        Width="480" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#14171F" Foreground="#F1F5F9">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="当前机型" FontSize="12" Foreground="#94A3B8"/>
            <TextBlock x:Name="CurrentLabel" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,8"/>
            <Border Background="#1E2330" CornerRadius="8" Padding="10">
                <StackPanel>
                    <TextBlock Text="自定义竖屏分辨率 / 比例（如 1080 × 2400 或 9 × 20）" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="CustomWidthBox" Width="80" Padding="6,4" Background="#0F1117" Foreground="White" BorderBrush="#334155"/>
                        <TextBlock Text=" × " VerticalAlignment="Center" Margin="6,0"/>
                        <TextBox x:Name="CustomHeightBox" Width="80" Padding="6,4" Background="#0F1117" Foreground="White" BorderBrush="#334155"/>
                        <Button Content="应用自定义" Margin="10,0,0,0" Padding="12,5" Click="OnApplyCustom"
                                Background="#3B82F6" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBox x:Name="SearchBox" Grid.Row="1" Padding="10,7" Margin="0,0,0,10"
                 Background="#1E2330" Foreground="White" BorderBrush="#334155"
                 TextChanged="OnSearchChanged" ToolTip="搜索品牌或型号（如 iPhone 17、Mate 70、xiaomi）"/>

        <ListBox x:Name="ModelList" Grid.Row="2" Background="#1A1E29" BorderBrush="#2D3343"
                 Foreground="#F1F5F9" MouseDoubleClick="OnModelDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayTitle}" FontSize="13.5" FontWeight="Medium"/>
                            <TextBlock Text="{Binding ResolutionText}" FontSize="11.5" Foreground="#94A3B8"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="选择" Padding="10,4" Click="OnSelectRow" Tag="{Binding}"
                                Background="#2563EB" Foreground="White" BorderThickness="0" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" FontSize="11.5" Foreground="#94A3B8"
                   Text="提示：更换比例会在线更新手机屏档位；若已在 UU远程 中连接，请切换一下屏幕再切回以确保点击位置精确。"/>
    </Grid>
</Window>
