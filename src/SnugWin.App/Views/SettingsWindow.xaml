<Window x:Class="SnugWin.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnugWin 设置"
        Width="780" Height="600"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BgCanvas}"
        Foreground="{StaticResource TextPrimary}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" Background="#090D13" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="14,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,22">
                    <Image Source="pack://application:,,,/Assets/snugwin-logo.png" Width="38" Height="38"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SnugWin" FontSize="17" FontWeight="Bold" Foreground="White"/>
                            <Border Background="#1D4ED8" CornerRadius="4" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionBadgeText" Text="v1.1" FontSize="10.5" FontWeight="SemiBold" Foreground="#DBEAFE"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="UU远程 手机竖屏伴侣" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavTabRadio}" Content="常规与手机屏"
                                 IsChecked="True" Checked="OnNavTabChanged"/>
                    <RadioButton x:Name="NavGestures" Style="{StaticResource NavTabRadio}" Content="手势与交互"
                                 Checked="OnNavTabChanged"/>
                    <RadioButton x:Name="NavDiagnostics" Style="{StaticResource NavTabRadio}" Content="驱动与日志"
                                 Checked="OnNavTabChanged"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavTabRadio}" Checked="OnNavTabChanged">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="关于与更新" VerticalAlignment="Center"/>
                            <Ellipse x:Name="UpdateDot" Width="7" Height="7" Fill="#34D399" Margin="7,0,0,0"
                                     VerticalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Bottom Live Status Pill -->
                <Border Grid.Row="2" Background="#131922" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="11,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse x:Name="StatusIndicatorDot" Width="8" Height="8" Fill="#60A5FA" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="StatusText" Text="待机中" FontSize="12.5" FontWeight="SemiBold" Foreground="#E6EDF3" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock x:Name="ElevationText" Text="管理员权限" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <Button x:Name="ElevateBtn" Content="以管理员重启" Style="{StaticResource SecondaryButton}"
                                Margin="0,8,0,0" Padding="8,4" FontSize="11.5" Click="OnRestartElevated" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right Content Workspace -->
        <Grid Grid.Column="1" Margin="22,20">
            <!-- Warning Banner when Driver Pipe Missing -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="DriverWarningBanner" Grid.Row="0" Background="#2B1F0E" BorderBrush="#92400E"
                    BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="虚拟显示器驱动尚未就绪" FontSize="13" FontWeight="SemiBold" Foreground="#FCD34D"/>
                        <TextBlock x:Name="DriverWarningText" FontSize="12" Foreground="#FDE68A" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="一键安装驱动" Style="{StaticResource PrimaryButton}"
                            Padding="12,6" FontSize="12" VerticalAlignment="Center" Click="OnInstallDriver"/>
                </Grid>
            </Border>

            <!-- PAGE 1: GENERAL -->
            <ScrollViewer x:Name="PageGeneral" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="常规与手机屏" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox x:Name="PhoneScreenCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,14"
                                      Checked="OnPhoneScreenChanged" Unchecked="OnPhoneScreenChanged">
                                <StackPanel>
                                    <TextBlock Text="手机连入时自动创建虚拟竖屏" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="检测到 UU远程连入即生成手机屏，断开后自动还原所有窗口" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="AutoStartCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,14"
                                      Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged">
                                <StackPanel>
                                    <TextBlock Text="开机静默自启动（后台常驻托盘）" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="通过 Windows 任务计划以最高权限启动，登录桌面不再弹 UAC 提示" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="ScreenshotCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,14"
                                      Checked="OnScreenshotChanged" Unchecked="OnScreenshotChanged">
                                <StackPanel>
                                    <TextBlock Text="在底部小横条左侧显示相机键" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="一键截取手机屏窗口到剪贴板，点击缩略图可 8 把手裁剪" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="ManualPhoneCheck" Style="{StaticResource ToggleSwitchCheckBox}"
                                      Checked="OnManualChanged" Unchecked="OnManualChanged">
                                <StackPanel>
                                    <TextBlock Text="手动强制开启手机屏（测试 / 自动探测兜底）" FontSize="13.5" FontWeight="SemiBold" Foreground="#93C5FD"/>
                                    <TextBlock Text="跳过 UU远程 信号检测，直接在本地桌面旁模拟启用竖屏手机屏" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Phone Model & Default Zoom Card -->
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="手机型号与屏幕比例" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="PhoneModelText" FontSize="15.5" FontWeight="SemiBold" Margin="0,3,0,12"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="终端 / 编辑器默认字号放大：" VerticalAlignment="Center" Foreground="#CBD5E1" FontSize="13"/>
                                    <ComboBox x:Name="ZoomCombo" Style="{StaticResource DarkComboBox}" Width="105" Margin="8,0,0,0" SelectionChanged="OnZoomChanged">
                                        <ComboBoxItem Content="0 级（默认）" Tag="0"/>
                                        <ComboBoxItem Content="+1 级" Tag="1"/>
                                        <ComboBoxItem Content="+2 级" Tag="2"/>
                                        <ComboBoxItem Content="+3 级" Tag="3"/>
                                        <ComboBoxItem Content="+4 级" Tag="4"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="预览手机界面" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0" Click="OnOpenPreview"/>
                                <Button Content="更换机型 / 自定义..." Style="{StaticResource PrimaryButton}"
                                        Click="OnOpenModels"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 2: GESTURES -->
            <ScrollViewer x:Name="PageGestures" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="手势与交互" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <CheckBox x:Name="GesturesCheck" Style="{StaticResource ToggleSwitchCheckBox}"
                                  Checked="OnGesturesChanged" Unchecked="OnGesturesChanged">
                            <StackPanel>
                                <TextBlock Text="在手机屏内开启原生触控手势翻译" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="将手机端划动、长按自动翻译为桌面滚轮、选字拖拽与右键交互" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <CheckBox x:Name="GestureScrollCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,14"
                                      Checked="OnGestureScrollChanged" Unchecked="OnGestureScrollChanged">
                                <StackPanel>
                                    <TextBlock Text="单指滑动转为平滑滚动与 60fps 惯性" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="长按 0.5 秒后拖动进入划选模式，浏览器标签栏保持原生点击直通" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="CopyAfterSelectionCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,14"
                                      Checked="OnCopyAfterSelectionChanged" Unchecked="OnCopyAfterSelectionChanged">
                                <StackPanel>
                                    <TextBlock Text="划选松手后弹出悬浮操作条（复制 / 粘贴 / 删除）" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="终端自动安全发送 Ctrl+Shift+C / V，删除发送 Backspace" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="GestureRightClickCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,14"
                                      Checked="OnGestureRightClickChanged" Unchecked="OnGestureRightClickChanged">
                                <StackPanel>
                                    <TextBlock Text="原地长按松开触发鼠标右键" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="如果在 PowerShell / 终端内习惯避免右键粘贴，可单独关闭此项" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="InjectedOnlyCheck" Style="{StaticResource ToggleSwitchCheckBox}"
                                      Checked="OnInjectedOnlyChanged" Unchecked="OnInjectedOnlyChanged">
                                <StackPanel>
                                    <TextBlock Text="仅接管 UU 注入触控事件" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="保留本机物理鼠标跨入手机屏时的原生点击与拖拽操作" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 3: DIAGNOSTICS & LOGS -->
            <Grid x:Name="PageDiagnostics" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="驱动与实时日志" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>

                <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="virtual-display-rs 0.3.1 驱动通道" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DiagPipeText" Text="检查中..." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="安装 / 修复驱动" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnInstallDriver"/>
                            <Button Content="打开日志目录" Style="{StaticResource SecondaryButton}" Click="OnOpenLogDir"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#080B10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="12">
                    <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" Background="Transparent" Foreground="#CBD5E1"
                             BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"/>
                </Border>
            </Grid>

            <!-- PAGE 4: ABOUT & UPDATES -->
            <ScrollViewer x:Name="PageAbout" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="关于与版本更新" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock x:Name="AboutVersionText" Text="当前版本：v1.1.0" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="UpdateStateText" Text="点击右侧按钮检查 GitHub 最新正式版" FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <ProgressBar x:Name="UpdateProgressBar" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="1"
                                             Foreground="#3B82F6" Background="#21262D" BorderThickness="0" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button x:Name="CheckUpdateBtn" Content="检查更新" Style="{StaticResource SecondaryButton}" Click="OnCheckUpdate"/>
                                <Button x:Name="InstallUpdateBtn" Content="下载并更新重启" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" Click="OnInstallUpdate" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <CheckBox x:Name="AutoCheckUpdatesCheck" Style="{StaticResource ToggleSwitchCheckBox}"
                                  Checked="OnAutoCheckUpdatesChanged" Unchecked="OnAutoCheckUpdatesChanged">
                            <StackPanel>
                                <TextBlock Text="启动时自动检查新版本" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="自动下载前会先校对 SHA-256 校验和，确保更新包完整安全" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="开源信息" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="• 本项目基于 MIT License 开源（nicocart/snug-win），1:1 承接上游 zephyr4123/snug（v2.5.0）交互设计" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="• 虚拟显示器驱动采用 MolotovCherry/virtual-display-rs（0.3.1）" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button Content="访问 GitHub 仓库主页" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OnOpenRepo"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
