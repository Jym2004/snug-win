<Window x:Class="SnugWin.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnugWin 设置与诊断"
        Width="660" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#11151E" Foreground="#F1F5F9">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Status Card -->
        <Border Grid.Row="0" Background="#1A202E" BorderBrush="#2A3346" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SnugWin — UU远程 手机竖屏伴侣" FontSize="17" FontWeight="Bold"/>
                    <TextBlock x:Name="StatusText" FontSize="13" Foreground="#60A5FA" Margin="0,4,0,0"/>
                    <TextBlock x:Name="DriverWarningText" FontSize="12" Foreground="#FBBF24" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="ElevationText" FontSize="12" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                    <Button x:Name="ElevateBtn" Content="以管理员重启" Padding="10,5" Background="#334155" Foreground="White" BorderThickness="0" Click="OnRestartElevated"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toggles & Options -->
        <Border Grid.Row="1" Background="#1A202E" BorderBrush="#2A3346" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <CheckBox x:Name="PhoneScreenCheck" Content="手机远程时自动创建「Snug 手机屏」" Foreground="#F1F5F9" FontSize="13.5" Margin="0,0,0,8"
                          Checked="OnPhoneScreenChanged" Unchecked="OnPhoneScreenChanged"/>
                <CheckBox x:Name="GesturesCheck" Content="在手机屏内开启原生手势（单指滚动 / 惯性 / 长按右键）" Foreground="#F1F5F9" FontSize="13.5" Margin="0,0,0,8"
                          Checked="OnGesturesChanged" Unchecked="OnGesturesChanged"/>
                <CheckBox x:Name="ScreenshotCheck" Content="在手机屏底部小横条左边放相机键（截图当前窗口到剪贴板，点缩略图可裁剪）" Foreground="#F1F5F9" FontSize="13.5" Margin="0,0,0,8"
                          Checked="OnScreenshotChanged" Unchecked="OnScreenshotChanged"/>
                <CheckBox x:Name="InjectedOnlyCheck" Content="仅接管系统注入的鼠标事件 (LLMHF_INJECTED)" Foreground="#CBD5E1" FontSize="12.5" Margin="0,0,0,8"
                          Checked="OnInjectedOnlyChanged" Unchecked="OnInjectedOnlyChanged"/>
                <CheckBox x:Name="ManualPhoneCheck" Content="手动强制开启手机屏（测试驱动 / 自动识别兜底）" Foreground="#93C5FD" FontSize="13"
                          Checked="OnManualChanged" Unchecked="OnManualChanged"/>
            </StackPanel>
        </Border>

        <!-- Phone Model & Zoom -->
        <Border Grid.Row="2" Background="#1A202E" BorderBrush="#2A3346" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="手机型号与比例" FontSize="12" Foreground="#94A3B8"/>
                    <TextBlock x:Name="PhoneModelText" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,8"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="终端 / 编辑器默认放大字号：" VerticalAlignment="Center" Foreground="#CBD5E1" FontSize="13"/>
                        <ComboBox x:Name="ZoomCombo" Width="90" Margin="8,0,0,0" SelectionChanged="OnZoomChanged">
                            <ComboBoxItem Content="0 级" Tag="0"/>
                            <ComboBoxItem Content="+1 级" Tag="1"/>
                            <ComboBoxItem Content="+2 级" Tag="2"/>
                            <ComboBoxItem Content="+3 级" Tag="3"/>
                            <ComboBoxItem Content="+4 级" Tag="4"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="更换机型 / 自定义..." Padding="12,8" VerticalAlignment="Top"
                        Background="#2563EB" Foreground="White" BorderThickness="0" Click="OnOpenModels"/>
            </Grid>
        </Border>

        <!-- Live Logs -->
        <Border Grid.Row="3" Background="#0B0E14" BorderBrush="#262E3F" BorderThickness="1" CornerRadius="10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="运行日志" FontSize="12.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <Button Content="打开日志目录" HorizontalAlignment="Right" Padding="8,3" FontSize="11.5"
                            Background="#1E293B" Foreground="#CBD5E1" BorderThickness="0" Click="OnOpenLogDir"/>
                </Grid>
                <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" Background="Transparent" Foreground="#CBD5E1"
                         BorderThickness="0" FontFamily="Consolas" FontSize="11.5"/>
            </Grid>
        </Border>
    </Grid>
</Window>
