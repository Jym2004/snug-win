<Window x:Class="SnugWin.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SnugWin"
        Width="464" Height="648"
        MinWidth="430" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        FontFamily="{StaticResource AppFont}"
        Background="Transparent"
        Foreground="{StaticResource TextPrimary}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            CornerRadius="12"
                            GlassFrameThickness="-1"
                            ResizeBorderThickness="5"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Mica Title & Navigation Chrome -->
        <Grid Grid.Row="0" Margin="16,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Title (Home) OR Subpage Back Button -->
            <StackPanel x:Name="HeaderBrandGroup" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="6" Background="#1EFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="3" Margin="0,0,9,0">
                    <Image Source="/SnugWin.App;component/Assets/snugwin-logo.png" Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="SnugWin" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                <Border Background="#18FFFFFF" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionBadgeText" Text="v1.2" FontSize="10.5" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                </Border>
            </StackPanel>

            <StackPanel x:Name="HeaderSubpageGroup" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource ChromeIconButton}" Width="Auto" Padding="8,0" Click="OnBackHome" ToolTip="返回主控制卡">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M9.5,3 L4.5,8 L9.5,13" Width="11" Height="11" Stretch="Uniform"
                              Stroke="{StaticResource TextPrimary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SubpageTitleText" Text="详情" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Quick Chrome Utility & Caption Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource ChromeIconButton}" Click="OnOpenDiagnosticsTab" ToolTip="驱动状态与实时日志" Margin="0,0,2,0">
                    <Grid Width="16" Height="16">
                        <Path Data="M2.5,3.5 L6.5,7.5 L2.5,11.5 M8,11.5 L13.5,11.5" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse x:Name="DiagAlertDot" Width="6" Height="6" Fill="{StaticResource WarningHeading}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource ChromeIconButton}" Click="OnOpenAboutTab" ToolTip="版本更新与关于" Margin="0,0,4,0">
                    <Grid Width="16" Height="16">
                        <Path Data="M8,14 A6,6 0 1 1 8,2 A6,6 0 1 1 8,14 Z M8,7.2 L8,10.8 M8,4.8 L8,5" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse x:Name="UpdateDot" Width="6" Height="6" Fill="{StaticResource SuccessText}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"/>
                    </Grid>
                </Button>

                <Border Width="1" Height="14" Background="#22FFFFFF" Margin="4,0,6,0" VerticalAlignment="Center"/>

                <Button Style="{StaticResource ChromeIconButton}" Click="OnMinimizeClick" ToolTip="最小化" Margin="0,0,2,0">
                    <Path Data="M3,8 L13,8" Width="10" Height="10" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                </Button>

                <Button Style="{StaticResource ChromeIconButton}" Click="OnCloseToTrayClick" ToolTip="收起到托盘">
                    <Path Data="M3,3 L11,11 M11,3 L3,11" Width="10" Height="10" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="16,4,16,16">

            <!-- VIEW 0: BENTO CONTROL CENTER -->
            <Grid x:Name="PageHome">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Hero Tile: Driver Setup Warning (when missing) OR Live Status + Reentry -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <!-- Missing Driver Hero Card -->
                    <Border x:Name="DriverWarningBanner"
                            Background="{StaticResource WarningBg}"
                            BorderBrush="{StaticResource WarningBorder}"
                            BorderThickness="1" CornerRadius="14" Padding="15,13"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M8,2 L14,13 L2,13 Z M8,6.5 L8,9.5 M8,11.3 L8,11.5" Width="15" Height="15" Stretch="Uniform"
                                          Stroke="{StaticResource WarningHeading}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="虚拟屏驱动未就绪" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource WarningHeading}"/>
                                </StackPanel>
                                <TextBlock x:Name="DriverWarningText" FontSize="11.5" Foreground="{StaticResource WarningBody}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="InstallDriverBtn" Grid.Column="1" Content="一键安装" Style="{StaticResource PrimaryButton}"
                                    Padding="14,8" FontSize="12.5" VerticalAlignment="Center" Click="OnInstallDriver"/>
                        </Grid>
                    </Border>

                    <!-- Ready / Live Status Hero Card -->
                    <Border x:Name="StatusHeroCard"
                            Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="14" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusIndicatorDot" Width="8" Height="8" Fill="#60A5FA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="StatusText" Text="待机中 · 等待手机连入" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock x:Name="ElevationText" Text="管理员权限" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock Text=" · 管道已连接" FontSize="11.5" Foreground="{StaticResource SuccessText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ElevateBtn" Content="提权重启" Style="{StaticResource SecondaryButton}"
                                        Padding="10,6" FontSize="11.5" Margin="0,0,6,0" Click="OnRestartElevated" Visibility="Collapsed"/>
                                <Button x:Name="HeroReentryBtn" Content="进入手机屏" Style="{StaticResource PrimaryButton}"
                                        Padding="13,7" FontSize="12" Click="OnReenterClick" Visibility="Collapsed"/>
                                <Border x:Name="HeroReadyBadge" Background="{StaticResource SuccessBg}" BorderBrush="{StaticResource SuccessBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="9,4" VerticalAlignment="Center">
                                    <TextBlock Text="已就绪" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessText}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2. Asymmetric Bento Middle Row: Phone Ratio + Terminal Zoom Stepper -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Bento Tile: Active Phone Model + Aspect Silhouette + Preview/Switch -->
                    <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="14" Padding="15,13">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="当前手机比例" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="PhoneModelText" Text="iPhone 17 Pro" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="PhoneSpecText" Text="1206 × 2622 · 200%" FontFamily="{StaticResource MonoFont}"
                                               FontSize="11.5" Foreground="{StaticResource AccentSoftText}" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Proportional Phone Outline Preview -->
                                <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1"
                                        CornerRadius="8" Width="40" Height="46">
                                    <Border x:Name="PhoneFrameOutline" Width="16" Height="34" CornerRadius="3"
                                            BorderBrush="{StaticResource AccentSoftText}" BorderThickness="1.5"
                                            Background="#253B82F6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="6" Height="1.5" CornerRadius="0.75" Background="{StaticResource AccentSoftText}"
                                                VerticalAlignment="Bottom" Margin="0,0,0,2.5"/>
                                    </Border>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="预览界面" Style="{StaticResource SecondaryButton}"
                                        Padding="8,7" FontSize="12" Click="OnOpenPreview"/>
                                <Button Grid.Column="2" Content="换机型..." Style="{StaticResource PrimaryButton}"
                                        Padding="8,7" FontSize="12" Click="OnOpenModels"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right Bento Tile: Tactile Zoom Stepper -->
                    <Border Grid.Column="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="14" Padding="14,13">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="终端 / IDE 字号" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>

                            <Grid Grid.Row="1" Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ZoomMinusBtn" Grid.Column="0" Content="−" Style="{StaticResource StepperButton}" Click="OnZoomMinus"/>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="ZoomValueText" Text="+2" FontFamily="{StaticResource MonoFont}"
                                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="放大档位" FontSize="10.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="ZoomPlusBtn" Grid.Column="2" Content="+" Style="{StaticResource StepperButton}" Click="OnZoomPlus"/>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="投屏自动放大，退出还原" FontSize="11" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. 2x2 Interactive Bento Quick-Toggle Grid -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tile 1: Auto Portrait Virtual Screen -->
                    <CheckBox x:Name="PhoneScreenCheck" Grid.Row="0" Grid.Column="0" Style="{StaticResource BentoTileCheckBox}"
                              Checked="OnPhoneScreenChanged" Unchecked="OnPhoneScreenChanged">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="34" Height="34" CornerRadius="10" Background="#1CFFFFFF" HorizontalAlignment="Left">
                                <Path Data="M5,2.5 L11,2.5 C11.8,2.5 12.5,3.2 12.5,4 L12.5,12 C12.5,12.8 11.8,13.5 11,13.5 L5,13.5 C4.2,13.5 3.5,12.8 3.5,12 L3.5,4 C3.5,3.2 4.2,2.5 5,2.5 Z M7,11.5 L9,11.5"
                                      Width="17" Height="17" Stretch="Uniform" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>
                            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                <TextBlock Text="自动竖屏" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="UU 连入自动建屏归位" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </CheckBox>

                    <!-- Tile 2: Touch Gestures + Subpage Shortcut -->
                    <Grid Grid.Row="0" Grid.Column="2">
                        <CheckBox x:Name="GesturesCheck" Style="{StaticResource BentoTileCheckBox}"
                                  Checked="OnGesturesChanged" Unchecked="OnGesturesChanged">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="34" Height="34" CornerRadius="10" Background="#1CFFFFFF" HorizontalAlignment="Left">
                                    <Path Data="M4,4 L12,4 M4,8 L14,8 M4,12 L10,12" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{StaticResource TextPrimary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Border>
                                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                    <TextBlock Text="触控手势" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="惯性滚轮 · 选字浮条" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </CheckBox>
                        <Button Content="细项 ›" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,28,0"
                                Padding="7,3" FontSize="11" Background="#22FFFFFF" Foreground="{StaticResource TextPrimary}"
                                BorderThickness="0" Cursor="Hand" Click="OnOpenGesturesTab" ToolTip="配置手势开关细项">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3EFFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Tile 3: Screenshot Camera Key -->
                    <CheckBox x:Name="ScreenshotCheck" Grid.Row="2" Grid.Column="0" Style="{StaticResource BentoTileCheckBox}"
                              Checked="OnScreenshotChanged" Unchecked="OnScreenshotChanged">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="34" Height="34" CornerRadius="10" Background="#1CFFFFFF" HorizontalAlignment="Left">
                                <Path Data="M2.5,5.5 L5,5.5 L6.2,3.5 L9.8,3.5 L11,5.5 L13.5,5.5 C14,5.5 14.5,6 14.5,6.5 L14.5,12.5 C14.5,13 14,13.5 13.5,13.5 L2.5,13.5 C2,13.5 1.5,13 1.5,12.5 L1.5,6.5 C1.5,6 2,5.5 2.5,5.5 Z M8,11.5 A2.2,2.2 0 1 1 8,7.1 A2.2,2.2 0 1 1 8,11.5 Z"
                                      Width="17" Height="17" Stretch="Uniform" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>
                            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                <TextBlock Text="截屏相机键" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="原图剪贴板 + 8把手裁剪" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </CheckBox>

                    <!-- Tile 4: Silent Autostart -->
                    <CheckBox x:Name="AutoStartCheck" Grid.Row="2" Grid.Column="2" Style="{StaticResource BentoTileCheckBox}"
                              Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="34" Height="34" CornerRadius="10" Background="#1CFFFFFF" HorizontalAlignment="Left">
                                <Path Data="M8,2.5 L8,7.5 M4.8,4.3 A5.2,5.2 0 1 0 11.2,4.3"
                                      Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"/>
                            </Border>
                            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                <TextBlock Text="开机自启动" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="最高权限静默常驻托盘" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </CheckBox>
                </Grid>

                <!-- 4. Bottom Utility Strip: Manual Override Test Toggle -->
                <Border Grid.Row="3" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="14" Padding="15,12">
                    <CheckBox x:Name="ManualPhoneCheck" Style="{StaticResource ToggleSwitchCheckBox}"
                              Checked="OnManualChanged" Unchecked="OnManualChanged">
                        <StackPanel>
                            <TextBlock Text="手动强制开启手机屏（测试 / 探测兜底）" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftText}"/>
                            <TextBlock Text="无需 UU 连入，直接生成并试用桌面侧手机工作区" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </Border>
            </Grid>

            <!-- VIEW 1: GESTURE DETAILS SUBPAGE -->
            <ScrollViewer x:Name="PageGestures" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="16,14">
                        <StackPanel>
                            <CheckBox x:Name="GestureScrollCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,14"
                                      Checked="OnGestureScrollChanged" Unchecked="OnGestureScrollChanged">
                                <StackPanel>
                                    <TextBlock Text="单指滑动转为平滑滚动与 60fps 惯性" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="长按 0.5 秒后拖动切换为划选模式，浏览器标签栏保持直通"
                                               FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{StaticResource BorderDivider}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="CopyAfterSelectionCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,14"
                                      Checked="OnCopyAfterSelectionChanged" Unchecked="OnCopyAfterSelectionChanged">
                                <StackPanel>
                                    <TextBlock Text="划选松手后弹出悬浮操作条（复制 / 粘贴 / 删除）" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="终端自动用 Ctrl+Shift+C / V，删除发 Backspace 不污染剪贴板"
                                               FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{StaticResource BorderDivider}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="GestureRightClickCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,14"
                                      Checked="OnGestureRightClickChanged" Unchecked="OnGestureRightClickChanged">
                                <StackPanel>
                                    <TextBlock Text="原地长按松开触发鼠标右键" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="如果在终端里不希望误触右键粘贴，可在此单独关闭"
                                               FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{StaticResource BorderDivider}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="InjectedOnlyCheck" Style="{StaticResource ToggleSwitchCheckBox}"
                                      Checked="OnInjectedOnlyChanged" Unchecked="OnInjectedOnlyChanged">
                                <StackPanel>
                                    <TextBlock Text="仅接管 UU 注入触控事件" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="保留本机物理鼠标跨入手机屏时的原生点击与拖拽手感"
                                               FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- VIEW 2: DIAGNOSTICS & LOGS SUBPAGE -->
            <Grid x:Name="PageDiagnostics" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="15,13" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="virtual-display-rs 0.3.1 驱动通道" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="DiagPipeText" Text="检查中..." FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Button Content="安装 / 修复驱动" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,8,0" Click="OnInstallDriver"/>
                            <Button Content="打开日志目录" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="OnOpenLogDir"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource BgWell}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="12">
                    <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" Background="Transparent" Foreground="#CBD5E1"
                             CaretBrush="#60A5FA" SelectionBrush="#2563EB"
                             BorderThickness="0" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                </Border>
            </Grid>

            <!-- VIEW 3: ABOUT & UPDATES SUBPAGE -->
            <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="AboutVersionText" Text="当前版本：v1.2.1" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="UpdateStateText" Text="点击下方按钮检查 GitHub 最新正式版" FontSize="12"
                                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                            <ProgressBar x:Name="UpdateProgressBar" Height="6" Margin="0,0,0,12" Minimum="0" Maximum="1"
                                         Foreground="{StaticResource AccentBlueHover}" Background="#24FFFFFF"
                                         BorderThickness="0" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckUpdateBtn" Content="检查更新" Style="{StaticResource SecondaryButton}" Click="OnCheckUpdate"/>
                                <Button x:Name="InstallUpdateBtn" Content="下载并更新重启" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" Click="OnInstallUpdate" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,10">
                        <CheckBox x:Name="AutoCheckUpdatesCheck" Style="{StaticResource ToggleSwitchCheckBox}"
                                  Checked="OnAutoCheckUpdatesChanged" Unchecked="OnAutoCheckUpdatesChanged">
                            <StackPanel>
                                <TextBlock Text="启动时自动检查新版本" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="升级前会自动校对 checksums.txt 的 SHA-256 哈希，确保更新包完整"
                                           FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="致谢与开源许可" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock Text="MIT License（nicocart/snug-win），承接上游 zephyr4123/snug（v2.5.0）交互与状态机。"
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="虚拟屏驱动基于 MolotovCherry/virtual-display-rs（0.3.1），内置 SHA-256 与签名指纹校验。"
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button Content="访问 GitHub 仓库" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OnOpenRepo"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
