<Window x:Class="SnugWin.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnugWin 设置"
        Width="900" Height="730"
        MinWidth="780" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BgCanvas}"
        Foreground="{StaticResource TextPrimary}">
    <Grid Background="{StaticResource BgCanvas}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Rail -->
        <Border Grid.Column="0"
                Background="{StaticResource BgSidebar}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,0,1,0"
                Padding="16,22,16,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Lockup -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,26">
                    <Border CornerRadius="10" Background="#161C28" BorderBrush="#263044" BorderThickness="1" Padding="4" Margin="0,0,12,0">
                        <Image Source="/SnugWin.App;component/Assets/snugwin-logo.png" Width="32" Height="32"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SnugWin" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <Border Background="{StaticResource AccentSoftBg}" BorderBrush="{StaticResource AccentSoftBorder}" BorderThickness="1"
                                    CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionBadgeText" Text="v1.2" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="UU远程 手机竖屏伴侣" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Primary Navigation -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavTabRadio}" IsChecked="True" Checked="OnNavTabChanged">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2,5.5 C2,4.1 3.1,3 4.5,3 L11.5,3 C12.9,3 14,4.1 14,5.5 L14,13.5 C14,14.9 12.9,16 11.5,16 L4.5,16 C3.1,16 2,14.9 2,13.5 Z M6.5,13.5 L9.5,13.5"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="常规与手机屏" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavGestures" Style="{StaticResource NavTabRadio}" Checked="OnNavTabChanged">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,4 L12,4 M4,8 L14,8 M4,12 L10,12"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="手势与交互" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavDiagnostics" Style="{StaticResource NavTabRadio}" Checked="OnNavTabChanged">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3,4 L7,8 L3,12 M8.5,12 L13.5,12"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="驱动与日志" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavTabRadio}" Checked="OnNavTabChanged">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M8,14.5 A6.5,6.5 0 1 1 8,1.5 A6.5,6.5 0 1 1 8,14.5 Z M8,7 L8,11 M8,4.6 L8,4.8"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="关于与更新" VerticalAlignment="Center"/>
                            <Ellipse x:Name="UpdateDot" Width="7" Height="7" Fill="{StaticResource SuccessText}" Margin="8,0,0,0"
                                     VerticalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Live Status Footer Card -->
                <Border Grid.Row="2" Background="#131823" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="11" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusIndicatorDot" Grid.Column="0" Width="8" Height="8" Fill="#60A5FA"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Grid.Column="1" Text="待机中" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <TextBlock x:Name="ElevationText" Text="管理员权限运行中" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                        <Button x:Name="ElevateBtn" Content="以管理员权限重启" Style="{StaticResource SecondaryButton}"
                                Margin="0,10,0,0" Padding="8,5" FontSize="11.5" Click="OnRestartElevated" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Column="1" Margin="28,24,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Missing Driver Inline Banner -->
            <Border x:Name="DriverWarningBanner" Grid.Row="0"
                    Background="{StaticResource WarningBg}"
                    BorderBrush="{StaticResource WarningBorder}"
                    BorderThickness="1" CornerRadius="11"
                    Padding="16,12" Margin="0,0,0,18"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0"
                          Data="M8,2 L14.5,13.5 L1.5,13.5 Z M8,6.5 L8,9.8 M8,11.6 L8,11.8"
                          Width="18" Height="18" Stretch="Uniform"
                          Stroke="{StaticResource WarningHeading}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="虚拟显示器驱动尚未就绪" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource WarningHeading}"/>
                        <TextBlock x:Name="DriverWarningText" FontSize="12" Foreground="{StaticResource WarningBody}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="InstallDriverBtn" Grid.Column="2" Content="一键安装内置驱动" Style="{StaticResource PrimaryButton}"
                            Padding="14,7" FontSize="12.5" VerticalAlignment="Center" Click="OnInstallDriver"/>
                </Grid>
            </Border>

            <!-- PAGE 1: GENERAL & PHONE SCREEN -->
            <ScrollViewer x:Name="PageGeneral" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="常规与手机屏" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="控制 UU远程 连入时的自动建屏、启动方式、机型比例与交互细节"
                               FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,14"/>

                    <TextBlock Text="运行行为" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,8"/>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="18,14">
                        <StackPanel>
                            <CheckBox x:Name="PhoneScreenCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,11"
                                      Checked="OnPhoneScreenChanged" Unchecked="OnPhoneScreenChanged">
                                <StackPanel>
                                    <TextBlock Text="手机连入时自动创建虚拟竖屏" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="检测到 UU远程 接入即生成匹配手机比例的 200% DPI 竖屏，断开后自动归位所有窗口"
                                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{StaticResource BorderDivider}" Margin="0,0,0,11"/>

                            <CheckBox x:Name="AutoStartCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,11"
                                      Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged">
                                <StackPanel>
                                    <TextBlock Text="开机静默自启动（后台常驻托盘）" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="通过 Windows 任务计划以最高权限启动，登录桌面不再弹出 UAC 提示"
                                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{StaticResource BorderDivider}" Margin="0,0,0,11"/>

                            <CheckBox x:Name="ScreenshotCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,11"
                                      Checked="OnScreenshotChanged" Unchecked="OnScreenshotChanged">
                                <StackPanel>
                                    <TextBlock Text="在底部小横条左侧显示相机键" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="一键截取手机屏窗口原图至剪贴板，点击缩略图可 8 把手裁剪"
                                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{StaticResource BorderDivider}" Margin="0,0,0,11"/>

                            <CheckBox x:Name="ManualPhoneCheck" Style="{StaticResource ToggleSwitchCheckBox}"
                                      Checked="OnManualChanged" Unchecked="OnManualChanged">
                                <StackPanel>
                                    <TextBlock Text="手动强制开启手机屏（测试 / 自动探测兜底）" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftText}"/>
                                    <TextBlock Text="跳过 UU远程 信号识别，直接在桌面旁模拟启用竖屏手机工作区"
                                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="机型比例与显示" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="2,16,0,8"/>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="18,14">
                        <StackPanel>
                            <!-- Row 1: Phone Model + Preview / Change Model Actions (dedicated spacious row) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="手机型号与屏幕比例" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="PhoneModelText" Text="加载中..." FontSize="13" FontWeight="Medium"
                                               Foreground="{StaticResource AccentSoftText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="OnOpenPreview"
                                            ToolTip="直接在桌面侧边预览手机界面与 App 网格">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M4.5,2.5 L11.5,2.5 C12.3,2.5 13,3.2 13,4 L13,12 C13,12.8 12.3,13.5 11.5,13.5 L4.5,13.5 C3.7,13.5 3,12.8 3,12 L3,4 C3,3.2 3.7,2.5 4.5,2.5 Z M7,11.5 L9,11.5"
                                                  Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="预览手机界面" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="更换机型 / 自定义..." Style="{StaticResource PrimaryButton}" Click="OnOpenModels"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderDivider}" Margin="0,0,0,12"/>

                            <!-- Row 2: Terminal / Editor Default Zoom -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="终端 / 编辑器默认字号放大" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="在手机屏打开 VS Code、Cursor 或 Windows Terminal 时自动放大字号，归位后还原"
                                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>

                                <ComboBox x:Name="ZoomCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="140"
                                          VerticalAlignment="Center" SelectionChanged="OnZoomChanged">
                                    <ComboBoxItem Content="0 级（默认）" Tag="0"/>
                                    <ComboBoxItem Content="+1 级" Tag="1"/>
                                    <ComboBoxItem Content="+2 级" Tag="2"/>
                                    <ComboBoxItem Content="+3 级" Tag="3"/>
                                    <ComboBoxItem Content="+4 级" Tag="4"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 2: GESTURES & INTERACTION -->
            <ScrollViewer x:Name="PageGestures" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="手势与交互" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="将手机触控划动、长按自动映射为更顺手的桌面滚轮、选字与上下文交互"
                               FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,18"/>

                    <TextBlock Text="总控开关" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,8"/>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="18,16">
                        <CheckBox x:Name="GesturesCheck" Style="{StaticResource ToggleSwitchCheckBox}"
                                  Checked="OnGesturesChanged" Unchecked="OnGesturesChanged">
                            <StackPanel>
                                <TextBlock Text="在手机屏内开启原生触控手势翻译" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="自动区分单指浏览滚动与长按选字操作，避免远程触控误选页面文字"
                                           FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <TextBlock Text="手势细项" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="2,20,0,8"/>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="18,16">
                        <StackPanel>
                            <CheckBox x:Name="GestureScrollCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,14"
                                      Checked="OnGestureScrollChanged" Unchecked="OnGestureScrollChanged">
                                <StackPanel>
                                    <TextBlock Text="单指滑动转为平滑滚动与 60fps 惯性" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="长按 0.5 秒后拖动切换为划选模式；浏览器顶部标签栏保持原生点击直通"
                                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{StaticResource BorderDivider}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="CopyAfterSelectionCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,14"
                                      Checked="OnCopyAfterSelectionChanged" Unchecked="OnCopyAfterSelectionChanged">
                                <StackPanel>
                                    <TextBlock Text="划选松手后弹出悬浮操作条（复制 / 粘贴 / 删除）" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="终端自动使用 Ctrl+Shift+C / V，删除发送 Backspace 且不污染剪贴板"
                                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{StaticResource BorderDivider}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="GestureRightClickCheck" Style="{StaticResource ToggleSwitchCheckBox}" Margin="0,0,0,14"
                                      Checked="OnGestureRightClickChanged" Unchecked="OnGestureRightClickChanged">
                                <StackPanel>
                                    <TextBlock Text="原地长按松开触发鼠标右键" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="如果终端内习惯禁用右键快捷粘贴，可在此单独关闭"
                                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border Height="1" Background="{StaticResource BorderDivider}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="InjectedOnlyCheck" Style="{StaticResource ToggleSwitchCheckBox}"
                                      Checked="OnInjectedOnlyChanged" Unchecked="OnInjectedOnlyChanged">
                                <StackPanel>
                                    <TextBlock Text="仅接管 UU 注入触控事件" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="保留本机物理鼠标滑入手机屏时的原生点按与拖拽手感"
                                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 3: DIAGNOSTICS & LOGS -->
            <Grid x:Name="PageDiagnostics" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="驱动与实时日志" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="检查 virtual-display-rs 命名管道健康状态与实时会话判定日志"
                               FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="virtual-display-rs 0.3.1 驱动通道" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="DiagPipeText" Text="检查中..." FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="安装 / 修复驱动" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="OnInstallDriver"/>
                            <Button Content="打开日志目录" Style="{StaticResource SecondaryButton}" Click="OnOpenLogDir"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource BgWell}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" Background="Transparent" Foreground="#CBD5E1"
                             CaretBrush="#60A5FA" SelectionBrush="#2563EB"
                             BorderThickness="0" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
                </Border>
            </Grid>

            <!-- PAGE 4: ABOUT & UPDATES -->
            <ScrollViewer x:Name="PageAbout" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="关于与版本更新" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="检查 GitHub 正式版更新（SHA-256 校验安装）与开源协议说明"
                               FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,18"/>

                    <TextBlock Text="版本与升级" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,8"/>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AboutVersionText" Text="当前版本：v1.2.1" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="UpdateStateText" Text="点击右侧按钮检查 GitHub 最新正式版" FontSize="12.5"
                                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <ProgressBar x:Name="UpdateProgressBar" Height="6" Margin="0,12,0,0" Minimum="0" Maximum="1"
                                             Foreground="{StaticResource AccentBlueHover}" Background="{StaticResource BgControl}"
                                             BorderThickness="0" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button x:Name="CheckUpdateBtn" Content="检查更新" Style="{StaticResource SecondaryButton}" Click="OnCheckUpdate"/>
                                <Button x:Name="InstallUpdateBtn" Content="下载并更新重启" Style="{StaticResource PrimaryButton}"
                                        Margin="10,0,0,0" Click="OnInstallUpdate" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,12,0,0">
                        <CheckBox x:Name="AutoCheckUpdatesCheck" Style="{StaticResource ToggleSwitchCheckBox}"
                                  Checked="OnAutoCheckUpdatesChanged" Unchecked="OnAutoCheckUpdatesChanged">
                            <StackPanel>
                                <TextBlock Text="启动时自动检查新版本" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="应用内热更新前会自动校对 checksums.txt 的 SHA-256 哈希，确保文件完整"
                                           FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <TextBlock Text="致谢与开源许可" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="2,20,0,8"/>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="本项目以 MIT License 开源维护（nicocart/snug-win），承接上游 zephyr4123/snug（v2.5.0）的产品体验与状态机设计。"
                                       FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="虚拟显示器驱动基于 MolotovCherry/virtual-display-rs（0.3.1），由 SHA-256 与签名指纹校验安装。"
                                       FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <Button Content="访问 GitHub 仓库主页" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OnOpenRepo"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
