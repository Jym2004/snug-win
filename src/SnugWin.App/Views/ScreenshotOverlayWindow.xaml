<Window x:Class="SnugWin.App.Views.ScreenshotOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnugScreenshotOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True">
    <Grid x:Name="ScalerRoot">
        <!-- Preview thumbnail card -->
        <Border x:Name="PreviewCard"
                Visibility="Collapsed"
                Background="#D1000000"
                CornerRadius="16"
                Padding="12"
                Cursor="Hand"
                MouseLeftButtonUp="OnPreviewClick">
            <StackPanel Orientation="Horizontal">
                <Border CornerRadius="8" ClipToBounds="True" Width="48" Height="48" Margin="0,0,12,0">
                    <Image x:Name="ThumbImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="已复制截图" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="点按裁剪" FontSize="15" FontWeight="Medium" Foreground="#B3FFFFFF" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Notice card -->
        <Border x:Name="NoticeCard"
                Visibility="Collapsed"
                Background="#D1000000"
                CornerRadius="16"
                Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NoticeGlyph" FontSize="20" FontWeight="SemiBold" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="NoticeHeadline" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="NoticeDetail" FontSize="15" FontWeight="Medium" Foreground="#B3FFFFFF"
                               Margin="0,2,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
