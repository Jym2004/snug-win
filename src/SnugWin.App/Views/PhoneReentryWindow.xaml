<Window x:Class="SnugWin.App.Views.PhoneReentryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnugReentry"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        FontFamily="{StaticResource AppFont}">
    <Border x:Name="PillBorder"
            Background="#EE161B22"
            BorderBrush="#403B82F6"
            BorderThickness="1"
            CornerRadius="20">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Padding="12,8,10,8" CornerRadius="19,0,0,19" Cursor="Hand"
                    MouseLeftButtonUp="OnReenterClick" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#253B82F6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/snugwin-logo.png" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0"/>
                    <TextBlock Text="进入手机屏" FontSize="13.5" FontWeight="SemiBold" Foreground="#F0F6FC" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Width="1" Background="#2B323D" Margin="0,7"/>
            <Border Padding="9,8,11,8" CornerRadius="0,19,19,0" Cursor="Hand"
                    MouseLeftButtonUp="OnHidePillClick" Background="Transparent" ToolTip="收起按钮（仍可从托盘菜单重进）">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="✕" FontSize="11.5" Foreground="#8B949E" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
