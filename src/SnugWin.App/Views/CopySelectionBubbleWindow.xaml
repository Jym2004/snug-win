<Window x:Class="SnugWin.App.Views.CopySelectionBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnugCopyBubble"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style x:Key="BubbleSegmentStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BubbleHoverBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BubbleDeleteSegmentStyle" TargetType="Border" BasedOn="{StaticResource BubbleSegmentStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#28EF4444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="10,6,10,14">
        <Border x:Name="BubbleBorder"
                Background="{DynamicResource BubbleBg}"
                BorderBrush="{DynamicResource BubbleBorder}"
                BorderThickness="1"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="14" Opacity="0.32"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource BubbleSegmentStyle}" CornerRadius="15,0,0,15" MouseLeftButtonUp="OnCopyClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M5,5 L12,5 L12,13 L5,13 Z M3,10 L3,3 L10,3"
                              Width="13" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource BubbleText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="复制" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource BubbleText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Width="1" Background="{DynamicResource BubbleDividerBg}" Margin="0,8"/>
                <Border Style="{StaticResource BubbleSegmentStyle}" CornerRadius="0" MouseLeftButtonUp="OnPasteClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M5,3.5 L11,3.5 L11,5 L5,5 Z M3.5,4.2 L3.5,13.5 L12.5,13.5 L12.5,4.2"
                              Width="13" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource BubbleText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="粘贴" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource BubbleText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Width="1" Background="{DynamicResource BubbleDividerBg}" Margin="0,8"/>
                <Border Style="{StaticResource BubbleDeleteSegmentStyle}" CornerRadius="0,15,15,0" MouseLeftButtonUp="OnDeleteClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M5,4 L13,4 L13,12 L5,12 L2,8 Z M7.5,6.2 L10.5,9.8 M10.5,6.2 L7.5,9.8"
                              Width="14" Height="14" Stretch="Uniform"
                              Stroke="{DynamicResource BubbleDeleteText}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="删除" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource BubbleDeleteText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
