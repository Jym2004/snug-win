<Window x:Class="SnugWin.App.Views.CopySelectionBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnugCopyBubble"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True">
    <Border x:Name="BubbleBorder"
            Background="#E61C1C1E"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="18"
            Padding="16,9"
            Cursor="Hand"
            MouseLeftButtonUp="OnCopyClick">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="复制" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
